{
  "name": "room-3d",
  "private": true,
  "version": "1.0.0",
  "description": "Room: Go To Hell - a 3D first-person reimagining of the original Java CLI game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run && playwright test",
    "typecheck": "tsc -p .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@pmndrs/assets": "^1.7.0",
    "n8ao": "^2.0.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.8"
  }
}
